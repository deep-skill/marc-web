# AWS
AWS_PROFILE=default
REGION=us-east-1
ACCOUNT_ID=750548849241

# Project naming
PROJECT=marc
ENV_NAME=prod

# Dominios (DNS gestionado por Cloudflare)
PROD_WEB_FQDN=marc.com.pe
PROD_API_FQDN=api.marc.com.pe

# Lambda
LAMBDA_FUNCTION_NAME=marc-prod-sismos-api
LAMBDA_RUNTIME=nodejs20.x
LAMBDA_HANDLER=index.handler
LAMBDA_TIMEOUT=10
LAMBDA_MEMORY=128

# API Gateway HTTP API
API_NAME=marc-prod-api
ALLOWED_ORIGIN=https://marc.com.pe

# Cloudflare Pages (frontend)
PAGES_PROJECT=marc-web
