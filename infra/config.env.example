# AWS
AWS_PROFILE=default
REGION=us-east-1
ACCOUNT_ID=750548849241

# Project naming (recursos AWS se llaman {PROJECT}-{ENV_NAME}-{recurso})
PROJECT=marc
ENV_NAME=prod

# Dominios (DNS gestionado por Cloudflare)
PROD_WEB_FQDN=marc.com.pe
PROD_API_FQDN=api.marc.com.pe

# Lambda
LAMBDA_FUNCTION_NAME=marc-prod-sismos-api
LAMBDA_RUNTIME=nodejs20.x
LAMBDA_HANDLER=index.handler
LAMBDA_TIMEOUT=10
LAMBDA_MEMORY=128

# API Gateway HTTP API
API_NAME=marc-prod-api
ALLOWED_ORIGINS=https://marc.com.pe,https://www.marc.com.pe

# Cloudflare Pages (frontend)
PAGES_PROJECT=marc-web
# CLOUDFLARE_API_TOKEN y CLOUDFLARE_ACCOUNT_ID se leen del entorno
# (estan en ~/marc-cloudflare-creds/.env.cloudflare, chmod 600).
# En CI vienen de los GitHub secrets configurados con `gh secret set`.
